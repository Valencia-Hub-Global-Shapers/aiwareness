NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Las siguientes dos son solo para scripts de mantenimiento
# (scripts/analyze_results.py, sync-hubs.js, setup-storage.js,
# upload-images.js), NUNCA para el frontend. No las pongas en Vercel;
# se exportan a mano o como GitHub Actions secrets. Nota: es
# "SUPABASE_URL" sin el prefijo NEXT_PUBLIC_, aunque el valor es el
# mismo Project URL de arriba.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Nota: si dejas este archivo sin rellenar (o no lo creas), la app
# funciona igualmente en "modo solo-interfaz": podrás navegar por todo
# el flujo, pero no se guardará nada en base de datos. Útil para revisar
# diseño/UX antes de tener un proyecto de Supabase listo.
